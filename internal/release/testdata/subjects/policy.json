{
  "schema": 9,
  "population": { "repositories": [{ "repo": "example" }] },
  "evidence": {
    "sbomSuffix": ".spdx.json",
    "checksums": "checksums.txt",
    "umbrellaBundle": "attestations.intoto.jsonl",
    "manifestAsset": "evidence-manifest.json",
    "classes": {
      "go-binary": {
        "bundles": ["attestations-go-binaries.intoto.jsonl"],
        "subjects": {
          "kind": "files",
          "entry": "^(?P<target>[^/\\\\ \\t\\n*?\\[]+)$",
          "unit": "target",
          "shape": "a plain name",
          "extension": ".tar.gz",
          "label": "${target}",
          "assets": [{ "noun": "archive", "of": "${target}", "suffix": "-${target}.tar.gz" }]
        }
      },
      "rust-binary": {
        "bundles": ["attestations-binaries.intoto.jsonl"],
        "subjects": {
          "kind": "files",
          "entry": "^(?P<target>[^/\\\\ \\t\\n*?\\[]+)$",
          "unit": "target",
          "shape": "a plain name",
          "extension": ".tar.gz",
          "label": "${target}",
          "assets": [{ "noun": "archive", "of": "${target}", "suffix": "-${target}.tar.gz" }]
        }
      },
      "pgrx-extension": {
        "bundles": ["attestations-extensions.intoto.jsonl"],
        "subjects": {
          "kind": "files",
          "entry": "^(?P<major>\\d+)-(?P<arch>[a-z0-9_]+)$",
          "unit": "cell",
          "shape": "<major>-<arch>",
          "extension": ".tar.gz",
          "label": "${major}",
          "assets": [
            { "noun": "tarball", "of": "pg${major}/${arch}", "suffix": "-pg${major}-linux-${arch}.tar.gz" },
            {
              "noun": "debug tarball",
              "of": "pg${major}/${arch}",
              "suffix": "-pg${major}-linux-${arch}-debug.tar.gz"
            }
          ]
        }
      },
      "pgrx-extension-image": {
        "bundles": ["attestations-extimg.intoto.jsonl"],
        "subjects": {
          "kind": "registry",
          "entry": "^\\d+$",
          "unit": "major",
          "shape": "a major",
          "extension": ".json",
          "legField": "pg"
        }
      },
      "board-firmware": {
        "bundles": ["attestations-firmware.intoto.jsonl"],
        "subjects": {
          "kind": "files",
          "entry": "^(?P<board>[a-z]+)@(?P<rev>r[0-9]+)$",
          "unit": "board",
          "shape": "<board>@r<rev>",
          "extension": ".bin",
          "label": "${board}.${rev}",
          "assets": [
            { "noun": "image", "of": "${board} ${rev}", "suffix": "_${board}_${rev}.bin" },
            { "noun": "recovery image", "of": "${board} ${rev}", "suffix": "_${board}_${rev}.rescue.bin" }
          ]
        }
      },
      "oci-image": { "bundles": ["attestations-image.intoto.jsonl"] }
    }
  }
}
